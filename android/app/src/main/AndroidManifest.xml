<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />
    <application android:label="@string/app_name" android:icon="@drawable/ic_launcher_bo2" android:allowBackup="false"
        android:theme="@style/Theme.BO2.Landscape"
        android:supportsRtl="true">
        <activity android:name=".GameActivity" android:exported="false" android:process=":game"
            android:theme="@style/Theme.BO2.Black"
            android:screenOrientation="sensorLandscape" android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density" />

        <activity android:name=".RelaunchActivity" android:exported="false" android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape" android:theme="@style/Theme.BO2.Black"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density" />
        <activity android:name=".LauncherActivity" android:exported="true" android:screenOrientation="sensorLandscape" android:enabled="${bo2LauncherEnabled}"
            android:launchMode="singleTask" android:theme="@style/Theme.BO2.Landscape"
            android:configChanges="keyboard|keyboardHidden|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".InputExtractorActivity" android:exported="false" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density" />
        <activity-alias android:name=".InputExtractorLauncher" android:targetActivity=".InputExtractorActivity"
            android:enabled="${bo2ExtractorEnabled}" android:exported="true" android:label="@string/input_extractor_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BO2.Landscape"
            android:configChanges="keyboard|keyboardHidden|screenLayout|uiMode|density" />
        <activity android:name=".ControlLayoutActivity" android:exported="false"
            android:screenOrientation="sensorLandscape" android:theme="@style/Theme.BO2.Black" />

        <receiver android:name=".TouchSettingsStore" android:exported="false" />

    </application>
</manifest>
