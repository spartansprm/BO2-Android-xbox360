# Game data and anything derived from it: never commit
/game/
work/
generated/
**/generated/
/app/codegen_gaps.txt
/campaign/codegen_gaps.txt
*.xex
*.xexp
*.pe
*.bin
*.ff
*.ipak
*.sabl
*.sabs
*.bik
*.webm
*.spvpack
*.gscpack
*.spvidx
