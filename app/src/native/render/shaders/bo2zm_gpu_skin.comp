#version 450
// GPU skinning (bo2zm_gpu_skin): the game's three CPU skinning kernels (sub_82912D78, sub_82913378,
// sub_82913B50; see app/src/bo2zm_native_skin.cpp for what they do, and bo2zm_gpu_skin.h for how a call becomes a
// job) as one compute shader. One invocation per vertex. It writes the 32 bytes the kernel would have written, as
// the renderer's vertex copy would have put them in the upload buffer (k8in32: each big-endian word as its value).
//
// One dispatch per submission: each workgroup's entry in the groups list names its job record and its first vertex.
// A job record (std430, 56 bytes) points at:
//   block   in the upload buffer, every word already byte-swapped to its value by the CPU copy: eight vectors (position
//           scale, position bias, K8, K9, K10, K11, one, the weight lanes: all bits or none), then the bone matrices'
//           snapshot from guest bones_lo on (four rows of four floats per bone) at bones_word;
//   inputs  the bone records (u16: 1, 3 or 5 per vertex) from the word holding the first one, then the input vertices
//           (six words each: position x y, z w as int16 pairs, two words kept, T, N) at vertices_word; swapped the
//           same way, in the persistent input cache or in the upload buffer;
//   target  the dispatch's first vertex's 32 bytes in the upload buffer.
//
// The float operations are the kernels' (multiply-adds in the same order); the GPU may round a product the CPU
// fused or the other way round, so a word can differ by the last bits (a packed field by one).
//
// The header is generated with:
//   glslangValidator -V --target-env vulkan1.1 --vn kSpirvBo2zmGpuSkin -o bo2zm_gpu_skin_cs.h bo2zm_gpu_skin.comp

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words {
  uint w[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Target {
  uint w[];
};

struct JobRecord {
  uint64_t block;
  uint64_t inputs;
  uint64_t target;
  uint count;         // vertices of this dispatch
  uint kernel;        // 0, 1, 2: one, two, three bones
  uint bones_word;    // in block
  uint records_byte;  // in inputs: the byte of this dispatch's first record
  uint vertices_word; // in inputs: this dispatch's first vertex
  uint bones_guest;   // the kernel's r6: a record's bone is the matrix at r6 + offset, rounded down to 16 (lvx)
  uint bones_lo;      // the guest address of the snapshot's first byte
  uint unused;
};
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer JobRecords {
  JobRecord j[];
};
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Groups {
  uvec2 g[];  // job record, first vertex
};

layout(push_constant) uniform Push {
  uint64_t jobs;
  uint64_t groups;
} push;

vec4 Vec(Words d, uint word) {
  return uintBitsToFloat(uvec4(d.w[word], d.w[word + 1u], d.w[word + 2u], d.w[word + 3u]));
}

// Halfword `index` of the records (big-endian pairs: the first is the word's high half).
uint Half(Words d, JobRecord job, uint index) {
  const uint byte_at = job.records_byte + index * 2u;
  const uint v = d.w[byte_at >> 2];
  return (byte_at & 2u) != 0u ? (v & 0xFFFFu) : (v >> 16);
}

struct Bone {
  vec4 r0, r1, r2, r3;
};

Bone Load(Words d, JobRecord job, uint offset) {
  const uint at = job.bones_word + ((((job.bones_guest + offset) & ~15u) - job.bones_lo) >> 2);
  return Bone(Vec(d, at), Vec(d, at + 4u), Vec(d, at + 8u), Vec(d, at + 12u));
}

// vupkd3d128 type 8 as the recompiled code does it: 3.0f's bits plus each signed 10-bit field (x's -512 a NaN),
// 1.0f's plus the 2-bit w.
vec4 Unpack(uint x) {
  const int a = bitfieldExtract(int(x), 0, 10);
  const int b = bitfieldExtract(int(x), 10, 10);
  const int c = bitfieldExtract(int(x), 20, 10);
  return uintBitsToFloat(uvec4(a == -512 ? 0x7FC00000u : uint(a + 0x40400000), uint(b + 0x40400000),
                               uint(c + 0x40400000), (x >> 30) | 0x3F800000u));
}

// vpkd3d128 type 2: each lane clamped to the floats whose low bits carry its field (a NaN stays), then the fields.
uint Pack(vec4 v) {
  const vec4 lo = uintBitsToFloat(uvec4(0x403FFE01u, 0x403FFE01u, 0x403FFE01u, 0x40400000u));
  const vec4 hi = uintBitsToFloat(uvec4(0x404001FFu, 0x404001FFu, 0x404001FFu, 0x40400003u));
  uvec4 bits;
  for (int i = 0; i < 4; ++i) {
    float t = v[i] > hi[i] ? hi[i] : v[i];
    t = v[i] < lo[i] ? lo[i] : t;
    bits[i] = floatBitsToUint(t);
  }
  return (bits.x & 0x3FFu) | ((bits.y & 0x3FFu) << 10) | ((bits.z & 0x3FFu) << 20) | ((bits.w & 3u) << 30);
}

// T or N rotated: z * row 2 and y * row 1 (round_y: the kernel's separate product is y * row 1), then x * row 0.
vec4 Chain(vec4 v, Bone m, bool round_y) {
  const vec4 a = round_y ? fma(vec4(v.z), m.r2, v.y * m.r1) : fma(vec4(v.y), m.r1, v.z * m.r2);
  return fma(vec4(v.x), m.r0, a);
}

void main() {
  const uvec2 group = Groups(push.groups).g[gl_WorkGroupID.x];
  const JobRecord job = JobRecords(push.jobs).j[group.x];
  const uint i = group.y + gl_LocalInvocationID.x;
  if (i >= job.count) {
    return;
  }
  Words d = Words(job.block);
  Words in_ = Words(job.inputs);
  const vec4 scale = Vec(d, 0u), bias = Vec(d, 4u), k8 = Vec(d, 8u), k9 = Vec(d, 12u), k10 = Vec(d, 16u),
             k11 = Vec(d, 20u), one = Vec(d, 24u);
  const uvec4 lanes = uvec4(d.w[28], d.w[29], d.w[30], d.w[31]);

  // The matrix: one bone, or the bones blended by the weights (u16 fractions, only in the weight lanes).
  Bone m;
  if (job.kernel == 0u) {
    m = Load(d, job, Half(in_, job, i));
  } else if (job.kernel == 1u) {
    const Bone a = Load(d, job, Half(in_, job, i * 3u));
    const Bone b = Load(d, job, Half(in_, job, i * 3u + 1u));
    const vec4 wb =
        uintBitsToFloat(floatBitsToUint(vec4(float(Half(in_, job, i * 3u + 2u)) * (1.0 / 65536.0))) & lanes);
    const vec4 wa = one - wb;
    m = Bone(fma(b.r0, wb, wa * a.r0), fma(b.r1, wb, wa * a.r1), fma(b.r2, wb, wa * a.r2),
             fma(b.r3, wb, wa * a.r3));
  } else {
    const Bone c = Load(d, job, Half(in_, job, i * 5u));
    const Bone a = Load(d, job, Half(in_, job, i * 5u + 1u));
    const Bone b = Load(d, job, Half(in_, job, i * 5u + 3u));
    const vec4 wa =
        uintBitsToFloat(floatBitsToUint(vec4(float(Half(in_, job, i * 5u + 2u)) * (1.0 / 65536.0))) & lanes);
    const vec4 wb =
        uintBitsToFloat(floatBitsToUint(vec4(float(Half(in_, job, i * 5u + 4u)) * (1.0 / 65536.0))) & lanes);
    const vec4 wc = (one - wb) - wa;
    m = Bone(fma(wc, c.r0, fma(wa, a.r0, b.r0 * wb)), fma(wc, c.r1, fma(wa, a.r1, b.r1 * wb)),
             fma(wc, c.r2, fma(wa, a.r2, b.r2 * wb)), fma(wc, c.r3, fma(wa, a.r3, b.r3 * wb)));
  }

  const uint v = job.vertices_word + i * 6u;
  const uint xy = in_.w[v], zw = in_.w[v + 1u];
  const vec4 p = fma(vec4(float(int(xy) >> 16), float(bitfieldExtract(int(xy), 0, 16)), float(int(zw) >> 16),
                          float(bitfieldExtract(int(zw), 0, 16))),
                     scale, bias);
  const vec4 t = fma(Unpack(in_.w[v + 4u]), k11, k10);
  const vec4 n = fma(Unpack(in_.w[v + 5u]), k11, k10);

  vec4 pa = fma(m.r2, vec4(p.z), m.r3);
  pa = fma(vec4(p.y), m.r1, pa);
  const vec4 pt = fma(vec4(p.x), m.r0, pa);
  // Which product each kernel rounds (bo2zm_native_skin.cpp: Skin1-3): y * row 1, except T in the two-bone one.
  const vec4 nt = Chain(n, m, true);
  const vec4 tt = Chain(t, m, job.kernel != 1u);

  Target o = Target(job.target + uint64_t(i) * 32ul);
  o.w[0] = floatBitsToUint(pt.x);
  o.w[1] = floatBitsToUint(pt.y);
  o.w[2] = floatBitsToUint(pt.z);
  o.w[3] = floatBitsToUint(p.w);
  o.w[4] = in_.w[v + 2u];
  o.w[5] = in_.w[v + 3u];
  o.w[6] = Pack(fma(tt, k8, k9));
  o.w[7] = Pack(fma(nt, k8, k9));
}
